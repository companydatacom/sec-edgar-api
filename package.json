{
  "name": "@companydata/sec-edgar-api",
  "version": "0.2.0",
  "description": "SEC EDGAR API wrapper: US company data from state registers and SEC EDGAR with full addresses, phone, email, website and firmographics, through one REST call. A thin layer over @companydata/companydata-sdk, pinned to US.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build",
    "pack:check": "npm pack --dry-run",
    "publish:public": "npm publish --access public",
    "test:live": "npx -y tsx examples/quickstart.ts"
  },
  "keywords": [
    "sec-edgar",
    "sec-edgar-api",
    "edgar",
    "cik",
    "usa",
    "united-states",
    "company-data",
    "secretary-of-state",
    "business-register",
    "company-search",
    "b2b-data",
    "sdk",
    "typescript"
  ],
  "homepage": "https://companydata.com/sec-edgar-api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/companydatacom/sec-edgar-api.git"
  },
  "bugs": {
    "url": "https://github.com/companydatacom/sec-edgar-api/issues"
  },
  "dependencies": {
    "@companydata/companydata-sdk": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
